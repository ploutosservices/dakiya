# Every setting the service reads. The values are the compose demo's; outside it, export your own.

# Required. libpq connection string for the service's own store (mailsend/migrations).
MAIL_SEND_DSN=host=postgres dbname=mailsend user=mailsend

# Required. The environment this service is: production sends exactly what was asked; any other
# word keeps every mail inside the tenant (To and Reply-To become the tenant's address, the subject
# says so). A caller's certificate must name the same environment.
MAIL_SEND_ENV=dev

# Where it listens: exactly one of the two. A unix socket behind your mTLS proxy, or a loopback port
# on a developer's machine.
MAIL_SEND_UDS=/sock/mail-send.sock
MAIL_SEND_PORT=

# Optional. The header your mTLS proxy sets from the verified certificate's subject.
# Default: X-Client-Identity.
MAIL_SEND_IDENTITY_HEADER=X-Client-Identity

# An inbox's credentials, under the prefix its row names in key_env. An smtp inbox takes four:
# the SMTP door as host:port, and this service's client certificate, its key and the CA that signed
# the door's certificate (files). A Google Workspace inbox takes <P>_CLIENT_EMAIL and <P>_PRIVATE_KEY
# (a service account with domain-wide delegation); a Gmail inbox takes <P>_CLIENT_ID,
# <P>_CLIENT_SECRET and <P>_REFRESH_TOKEN (an OAuth client and the inbox's refresh token).
DEMO_SMTP_ADDRESS=smtp:1025
DEMO_SMTP_CERT=/certs/mail-send.pem
DEMO_SMTP_KEY=/certs/mail-send.key
DEMO_SMTP_CA=/certs/ca.pem
